# Worker backend switch (phaseado)
# baseline: d1 | cutover: supabase
DB_BACKEND=d1
DB_TOPOLOGY=single

# Frontend-safe
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your_publishable_key>

# Backend only (never expose in frontend bundle/logs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your_service_role_key>

# Required for local scripts that operate non-public schemas (catalog/core/missions/...)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional split read/write (hybrid topology)
SUPABASE_WRITE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_READ_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Worker operational tuning (optional)
SUPABASE_POOL_MAX=8
SUPABASE_CONNECT_TIMEOUT_MS=4000
SUPABASE_QUERY_TIMEOUT_MS=8000
SUPABASE_STATEMENT_TIMEOUT_MS=15000
SUPABASE_IDLE_TIMEOUT_MS=30000
REQUEST_DEDUPE_WINDOW_MS=1200
HOT_GET_CACHE_TTL_MS=3500
