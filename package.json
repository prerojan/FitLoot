{
  "name": "fitloot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "hono": "^4.7.7",
    "lucide-react": "^0.510.0",
    "pg": "^8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^7.5.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.0",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@eslint/js": "9.25.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.14.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "^10.4.21",
    "eslint": "9.25.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.0"
  },
  "scripts": {
    "build": "npm run sync:android-artifacts && tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "npm run sync:android-artifacts && tsc && vite build && wrangler deploy --dry-run",
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "dev:all": "bash -c \"npm run dev & npm run dev:worker\"",
    "lint": "eslint .",
    "test": "npm run lint && npm run build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:worker": "wrangler deploy --dry-run",
    "setup:test-env": "bash ./scripts/setup-test-env.sh",
    "debug:npm-config": "npm config list && npm config get registry",
    "check:lite": "node ./scripts/static-checks.mjs",
    "ai:check": "npm run check:lite",
    "validate": "npm run check:lite",
    "sync:android-artifacts": "node ./scripts/sync-android-artifacts.mjs",
    "supabase:reset-clean-base": "node ./scripts/supabase/reset-clean-base.mjs",
    "supabase:bootstrap-catalog": "node --experimental-strip-types ./scripts/supabase/bootstrap-catalog.mjs",
    "supabase:generate-catalog-seed-sql": "node --experimental-strip-types ./scripts/supabase/generate-catalog-seed-sql.mjs",
    "supabase:import-promo-codes": "node ./scripts/supabase/import-promo-codes-from-d1.mjs",
    "supabase:verify-clean-base": "node ./scripts/supabase/verify-clean-base.mjs",
    "supabase:prepare-clean-base": "npm run supabase:reset-clean-base && npm run supabase:bootstrap-catalog && npm run supabase:import-promo-codes",
    "supabase:quarantine-legacy": "node ./scripts/supabase/quarantine-legacy-tables.mjs",
    "supabase:restore-quarantine": "node ./scripts/supabase/restore-quarantined-legacy-tables.mjs",
    "supabase:drop-quarantine": "node ./scripts/supabase/drop-quarantined-legacy-tables.mjs"
  }
}
