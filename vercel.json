{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app-release.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app-dev-debug.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app-internal-debug.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/android-artifacts.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/android-artifacts.json",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/android-artifacts.json"
    },
    {
      "source": "/FitLoot.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot.apk"
    },
    {
      "source": "/FitLoot-Dev.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot-Dev.apk"
    },
    {
      "source": "/FitLoot-Internal.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot-Internal.apk"
    },
    {
      "source": "/app-release.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot.apk"
    },
    {
      "source": "/app-dev-debug.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot-Dev.apk"
    },
    {
      "source": "/app-internal-debug.apk",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/FitLoot-Internal.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://fitloot-worker.suportefitloot.workers.dev/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
